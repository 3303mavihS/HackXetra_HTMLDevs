# Server environment variables
# Copy this file to .env and fill in the values. NEVER commit .env.

# PostgreSQL connection string (Supabase pooler)
# NOTE: The previously committed password was leaked in git history and has
# been rotated. Use the NEW password from the Supabase dashboard.
DATABASE_URL=postgresql://postgres.<project-ref>:<NEW_ROTATED_PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# GetStream Chat credentials
# NOTE: The previously committed key/secret were leaked in git history and
# have been rotated. Generate NEW ones from the Stream dashboard.
STREAM_API_KEY=your_new_stream_api_key
STREAM_SECRET=your_new_stream_secret

# Port (optional, defaults to 3001)
PORT=3001
